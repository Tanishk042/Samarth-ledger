# ── Frontend (safe to expose, prefixed with VITE_) ─────────────────────────────
# Leave blank to use the built-in simulated hash-chain ledger.
VITE_CONTRACT_ADDRESS=
# Polygon Amoy public RPC (read-only verification)
VITE_CHAIN_RPC=https://rpc-amoy.polygon.technology
VITE_CHAIN_ID=80002
# Optional: force browser API calls while running the Vite dev server.
# Vercel builds enable them automatically; leave blank for pure local-first demo.
VITE_ENABLE_API=

# ── Serverless (never exposed to the browser) ─────────────────────────────────
# Optional vision-language second opinion in /api/forensic.
# Without it the deterministic, explainable heuristic engine is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional durable persistence. The prototype is local-first and works with
# none of these set. /api/fdrs automatically mirrors to the first store found.
# Vercel KV / Upstash Redis (REST)
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Neon Postgres (a single `kv` table is created on demand)
DATABASE_URL=

# Optional: server-side signing salt for demo proof/release envelopes.
DEMO_SIGNING_SECRET=
