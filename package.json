{
  "name": "fdr-ledger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Autonomous Security Deposit & FDR Management Ledger — Smart India Hackathon prototype",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"api/**/*.js\"",
    "samples": "node scripts/make-samples.mjs",
    "test:api": "node scripts/test-api.mjs",
    "test:scoring": "node scripts/test-scoring.mjs",
    "contract:compile": "cd contracts && npx hardhat compile",
    "contract:test": "cd contracts && npx hardhat test",
    "contract:deploy:amoy": "cd contracts && npx hardhat run scripts/deploy.js --network amoy"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "d3-force": "^3.0.0",
    "ethers": "^6.13.4",
    "framer-motion": "^11.11.17",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.460.0",
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20"
  }
}
